{
    "name": "phpsoftbox/orm",
    "description": "ORM component for the PhpSoftBox framework",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Anton K.",
            "email": "inspector-who@mail.ru"
        }
    ],
    "require": {
        "php": "^8.5",
        "phpsoftbox/clock": "^1.0",
        "phpsoftbox/collection": "^1.0",
        "phpsoftbox/data-casting": "^1.0",
        "phpsoftbox/database": "^1.0",
        "phpsoftbox/database-lookup": "^1.0",
        "phpsoftbox/encryptor": "^1.0",
        "phpsoftbox/inflector": "^1.0",
        "psr/container": "^2.0",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpsoftbox/cs-fixer": "^1.2.2",
        "phpsoftbox/storage": "^1.0",
        "phpsoftbox/validator": "^1.0"
    },
    "suggest": {
        "ext-mongodb": "Required for Mongo changelog driver.",
        "mongodb/mongodb": "Required for Mongo changelog driver.",
        "phpsoftbox/mongo": "Provides MongoConnectionManagerInterface for Mongo changelog driver."
    },
    "autoload": {
        "psr-4": {
            "PhpSoftBox\\Orm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PhpSoftBox\\Orm\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "cs:fix": "vendor/bin/psb-cs-fixer fix",
        "cs:check": "vendor/bin/psb-cs-fixer check --diff"
    },
    "prefer-stable": true
}
